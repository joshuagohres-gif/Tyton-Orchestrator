# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="file:./dev.db"
# Database pool settings for PostgreSQL (production)
# DATABASE_URL="postgresql://user:password@localhost:5432/tyton?connection_limit=20&pool_timeout=20"
DB_CONNECTION_LIMIT=20
DB_POOL_TIMEOUT=20000

# Auth & Security
JWT_SECRET=your-jwt-secret-here-change-in-production-256-bit-minimum
SESSION_SECRET=your-session-secret-here-change-in-production
API_KEY_HASH_SALT=your-api-key-salt-here-change-in-production-256-bit

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here
MODEL_OPENAI=gpt-4o

# Anthropic API (optional)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
MODEL_ANTHROPIC=claude-3-5-sonnet

# Orchestration settings
ORCHESTRATION_MAX_TOKENS=4000
RATE_LIMIT_REQ_PER_MIN=60
ORCH_CONCURRENCY=3
ORCH_PARALLEL_EXECUTION=true

# Redis Cache & Rate Limiting
REDIS_URL=redis://localhost:6379
CACHE_ENABLED=true
CACHE_LLM_TTL=21600
CACHE_SOURCING_TTL=86400

# LLM & Caching
LLM_CACHE_TTL_SEC=21600
LLM_BATCH_WINDOW_MS=100
LLM_BUDGET_DEFAULT_USD=25

# Database Configuration (Phase 4)
DB_CONNECTION_LIMIT=20
DB_POOL_TIMEOUT=20000
DB_MAX_IDLE_TIME=300000
DB_RETRY_ATTEMPTS=3
DB_RETRY_DELAY=1000

# Backup Configuration
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true
MAX_BACKUP_SIZE_MB=1000
BACKUP_EXCLUDE_TABLES=
BACKUP_INCLUDE_DATA=true
BACKUP_INCLUDE_SCHEMA=true

# Performance Monitoring
SLOW_QUERY_THRESHOLD_MS=1000
MAX_SLOW_QUERIES_STORED=50
DB_HEALTH_CHECK_INTERVAL=30000

# CORS
CORS_ORIGIN=http://localhost:3000

# Observability (Phase 5)
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector:4318
SENTRY_DSN=your-sentry-dsn-here

# Security Settings
RATE_LIMIT_GENERAL_RPM=60
RATE_LIMIT_AUTH_RPM=5
RATE_LIMIT_ORCH_RPM=10
RATE_LIMIT_LLM_RPM=100

# Password Requirements
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true